# Copy to .env and fill in. Never commit .env — it's git-ignored.

# Local Postgres (docker-compose). In production this becomes the Supabase
# pooler URL on port 6543, not a direct 5432 connection — see ARCHITECTURE.md.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/slack_workplace_assistant

# Slack app credentials — from api.slack.com/apps, Basic Information page.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Google OAuth credentials — from console.cloud.google.com, OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Groq API key — console.groq.com. Free tier, no card.
GROQ_API_KEY=

# Fernet key protecting per-tenant secrets (bot tokens, refresh tokens) at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=1

# Shared secret protecting /internal/tick from unauthenticated callers.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SHARED_SECRET=
